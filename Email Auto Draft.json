        "inputText": "={{ $json.snippet }}",
        "categories": {
          "categories": [
            {
              "category": "Social Media",
              "description": "=Emails related to social networking platforms, content engagement, community interactions, or platform notifications. This includes notifications about likes, comments, mentions, follows, direct messages, connection requests, account updates, verification alerts, and marketing campaigns from social media platforms.\n\nExamples include:\n\n- LinkedIn connection requests.\n- Facebook notifications\n- Instagram mentions or DMs\n- X (Twitter) alerts\n- YouTube comments\n- TikTok updates\n\nDo NOT include:\n\n- Customer complaints from users (those go to Customer Support)\n- Paid advertising invoices (those go to Finance)"
            },
            {
              "category": "Promotion",
              "description": "=Emails from customers, users, or clients requesting help, reporting issues, asking product questions, submitting complaints, requesting refunds, or seeking technical assistance.\n\nExamples include:\n\n-“I can't log into my account”\n-“Your product isn’t working”\n-“Can you explain your pricing?”\n-“I need help with my order”\n-“Please cancel my subscription”\n\nDo NOT include:\n-Automated support ticket confirmations (unless manual response is required)\n-Internal team discussions"
            },
            {
              "category": "Finance Label",
              "description": "=Emails related to financial transactions, billing, invoices, payments, receipts, bank notifications, payroll, tax documents, subscriptions, or expense reports.\n\nExamples include:\n-Invoice from vendors\n-Stripe / PayPal payment confirmation\n-Bank transaction alerts\n-Credit card statements\n-Subscription billing notifications\n-Tax forms\n-Refund confirmations\n\nDo NOT include:\n-Customer refund requests (those go to Customer Support)\n-Marketing newsletters from financial companies (those can be filtered)"
            },
            {
              "category": "High Priority",
              "description": "=Emails that require urgent attention, immediate response, or time-sensitive action. These emails typically involve deadlines, critical issues, important clients, revenue impact, system failures, legal matters, executive communication, or urgent customer escalations.\n\n\nClassify an email as high_priority = true if it includes:\n-Urgent language (e.g., “ASAP”, “urgent”, “immediately”, “today”, “critical”)\n-Service outages or technical failures\n-Payment failures affecting revenue\n-Executive or VIP communication\n-Legal or compliance issues\n-Escalated customer complaints\n-Deadline-driven requests\n-Security alerts or account breaches\n\n\nDo NOT mark as high priority:\n-General newsletters\n-Marketing emails\n-Social media notifications\n-Routine invoices without urgency\n-Standard updates with no deadline"
            }
          ]
        },
        "options": {
          "enableAutoFixing": true
        }
